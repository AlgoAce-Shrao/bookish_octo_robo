{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run Java",
            "type": "shell",
            "command": "javac",
            "args": [
                "Main.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "execute Java",
            "type": "shell",
            "command": "java",
            "args": [
                "<",
                "input.txt",
                ">",
                "output.txt"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "dependsOn": "run Java"
        },
        {
            "label": "build prac.java",
            "type": "shell",
            "command": "javac",
            "args": [
                "prac.java"
            ],
            "options": {
                "cwd": "${workspaceFolder}/hashing"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$javac"
            ],
            "presentation": {
                "reveal": "silent"
            }
        }
    ]
}